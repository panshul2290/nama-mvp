{
  "name": "nama-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "tsx supabase/tests/run.ts pglite",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "brand:assets": "node scripts/brand-assets.mjs",
    "seed:demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "demo": "tsx --env-file-if-exists=.env.local scripts/demo-activity.mts",
    "db:apply": "node --env-file-if-exists=.env.local scripts/apply-migration.mjs",
    "test:db:supabase": "tsx --env-file-if-exists=.env.local supabase/tests/run.ts supabase",
    "evidence": "node --env-file-if-exists=.env.local scripts/evidence.mjs",
    "test:unit": "tsx tests/unit/tracking.test.ts && tsx tests/unit/privacy.test.ts && tsx tests/unit/phone.test.ts && tsx tests/unit/legs.test.ts && tsx tests/unit/apps.test.ts && tsx tests/unit/time.test.ts && tsx tests/unit/recommend.test.ts && tsx tests/unit/training.test.ts && tsx tests/unit/importRegister.test.ts && tsx tests/unit/i18n.test.ts && tsx tests/unit/ubl.test.ts",
    "verify:seed": "tsx scripts/verify-demo-seed.mts",
    "build:apk:customer": "node --env-file-if-exists=.env.local scripts/build-mobile.mjs customer",
    "build:apk:driver": "node --env-file-if-exists=.env.local scripts/build-mobile.mjs driver",
    "build:apk:customer:demo": "node --env-file-if-exists=.env.local scripts/build-mobile.mjs customer --demo",
    "build:apk:driver:demo": "node --env-file-if-exists=.env.local scripts/build-mobile.mjs driver --demo",
    "import:register": "tsx --env-file-if-exists=.env.local scripts/import-register.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
