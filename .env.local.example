# Copy to .env.local (gitignored) and fill in from Supabase → Project Settings → API.

# Public: shipped to the browser. Safe because every table is behind RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...). The legacy anon key also works,
# under this name or as NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo only: shows a "Simulate trip" button on the driver's trip screen. It plays
# back a road route in Muscat through the normal location updates, so the
# customer's screen behaves as with a real driver. Leave unset (false) in production.
NEXT_PUBLIC_DEMO_MODE=true

# SECRET. Used only by `npm run seed` (scripts/seed.ts) — never by the app.
# Do not rename it with a NEXT_PUBLIC_ prefix: that would expose it to every browser.
# The legacy "service_role" key or the newer secret key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# Road routing for ETAs and the demo trip simulator. Defaults to the public OSRM
# demo server (demo use only: it sees tanker and delivery coordinates). Point it
# at a self-hosted OSRM for anything else.
# NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org

# Only for `npm run db:apply`: Postgres connection string (Project Settings → Database).
# DATABASE_URL=

# Optional: password for both seeded accounts (default: Tanker-test-2026).
# SEED_PASSWORD=
